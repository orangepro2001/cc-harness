# Copy to ~/.config/cc-harness/env (chmod 600) and edit.
HARNESS_PASSWORD=change-me

# "auto" = Tailscale address + LAN address(es), re-detected every 15s.
# Or list explicit addresses: 100.x.y.z,192.168.1.10:8765
HARNESS_BIND=auto
HARNESS_PORT=8765

# Extra directories sessions may use as working directory (':' separated).
# The per-user private workspace is always allowed.
#HARNESS_ROOTS=/home/you/projects

# Optional per-user passwords: those users can NOT log in with the shared one.
#HARNESS_USER_PASSWORDS=alice=pw1,bob=pw2

#HARNESS_DATA=/home/you/.local/share/cc-harness
#HARNESS_CLAUDE_BIN=/home/you/.local/bin/claude
#HARNESS_IDLE_TIMEOUT=30m
#HARNESS_MAX_PROCS=8
#HARNESS_TOKEN_TTL=720h
#HARNESS_BASE_PATH=/claude   # URL prefix when served behind a path-routing proxy (tailscale serve --set-path)
#HARNESS_MAX_UPLOAD_MB=25   # per-file upload limit
#HARNESS_RELEASES=/home/you/.local/share/cc-harness/releases   # published client builds
#HARNESS_ALLOW_BYPASS=1   # allow bypassPermissions sessions (off by default)
